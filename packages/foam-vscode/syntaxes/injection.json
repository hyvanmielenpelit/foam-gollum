{
  "scopeName": "foam.wikilink.injection",
  "injectionSelector": "L:meta.paragraph.markdown, L:markup.heading.markdown, L:markup.list.unnumbered.markdown, L:markup.list.numbered.markdown, L:meta.block.html, L:text.html.basic, L:meta.tag.inline.any.html, L:meta.tag.block.any.html, L:markup.quote.markdown",
  "patterns": [
    {
      "comment": "Standard Markdown hyperlink and image link coloring",
      "match": "(!?\\[)(.*?)(\\])(\\()([^\\)]*)(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.metadata.markdown.foam" },
        "2": { "name": "comment.line.wikilink.target.markdown.foam" },
        "3": { "name": "punctuation.definition.metadata.markdown.foam" },
        "4": { "name": "punctuation.definition.metadata.markdown.foam" },
        "5": { "name": "string.other.link.title.markdown.foam" },
        "6": { "name": "punctuation.definition.metadata.markdown.foam" }
      }
    },
    {
      "comment": "Footnote reference: [^id] (not a definition line [^id]: ...)",
      "match": "\\[(\\^[^\\]]+)\\](?!:)",
      "captures": {
        "1": { "name": "string.other.link.title.markdown.foam" }
      }
    },
    {
      "name": "meta.link.wikilink.markdown.foam",
      "begin": "\\[\\[",
      "end": "\\]\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.markdown.foam"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.markdown.foam"
        }
      },
      "patterns": [
        {
          "comment": "Wikilink with alias: [[target|alias]]",
          "match": "([^|\\]]+)(\\|)([^\\]]*)",
          "captures": {
            "1": {
              "name": "comment.line.wikilink.target.markdown.foam"
            },
            "2": {
              "name": "punctuation.definition.metadata.markdown.foam"
            },
            "3": {
              "name": "string.other.link.title.markdown.foam"
            }
          }
        },
        {
          "comment": "Wikilink without alias (unclosed or target)",
          "match": "[^|\\]]+",
          "name": "string.other.link.title.markdown.foam"
        }
      ]
    }
  ]
}
